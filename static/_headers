# Site override of themes/ryder/static/_headers (Ryder v0.5.0). A file here
# shadows the theme's file at the same path, so the theme's rules do not ship.
#
# Why: the theme's catch-all `/*` Cache-Control rule overlaps every other rule,
# and Cloudflare joins the values of a header set by more than one matching
# rule, so fingerprinted CSS/JS would go out as "…immutable, public, max-age=0,
# must-revalidate". Its `/images/*` rule also marks unfingerprinted
# static/images files immutable for a year.
#   Upstream bug:   https://github.com/arts-link/ryder/issues/115
#   Removal:        https://github.com/benstraw/benstrawbridge.com/issues/128
#   Delete this file once that fix ships in a tagged Ryder release.
#
# Rules must not overlap for the same header. `:file` matches one path segment
# only, so /css/:file never matches /css/images/…. Anything not listed gets
# Cloudflare's default for static assets, which revalidates (fine for HTML).
#
# scripts/cf-build.sh appends an X-Robots-Tag rule to the built copy on
# preview branches; it sets a different header, so it overlaps nothing here.

# Fingerprinted (or version-named, e.g. leaflet.1.9.4.*) bundles in production.
/css/:file
  Cache-Control: public, max-age=31536000, immutable

/js/:file
  Cache-Control: public, max-age=31536000, immutable

# Leaflet layer-control images, referenced by relative path from the CSS.
/css/images/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=604800

/index.xml
  Cache-Control: public, max-age=3600
