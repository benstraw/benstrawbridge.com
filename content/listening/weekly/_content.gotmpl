{{ $v1 := dict }}
{{ with site.Data.music_garden }}{{ with .v1 }}{{ $v1 = . }}{{ end }}{{ end }}
{{ if $v1.manifest }}
  {{ range $year, $weeks := $v1.weeks }}
    {{ range $weekId, $week := $weeks }}
      {{ $date := time.AsTime (printf "%sT00:00:00Z" $week.weekStart) }}
      {{ $view := merge $week (dict "date_start" $week.weekStart "date_end" $week.weekEnd "week" $weekId "year" $year) }}
      {{ $params := dict "hideAsideBar" true "musicGardenV1" true "weekData" $view "weekDataKey" $weekId "yearDataKey" $year "year" $year "date_start" $week.weekStart "date_end" $week.weekEnd "total_plays" $week.total_plays "unique_artists" $week.unique_artists "topArtistImages" ($week.topArtistImages | default slice) "topArtistName" $week.topArtistName }}
      {{ $page := dict "content" (dict "mediaType" "text/markdown" "value" (printf "%d aggregate plays · Top artist: %s" ($week.total_plays | int) $week.topArtistName)) "kind" "page" "title" (printf "Listening week of %s" $week.weekStart) "type" "listening-weekly" "params" $params "path" $weekId "dates" (dict "date" $date) }}
      {{ $.AddPage $page }}
    {{ end }}
  {{ end }}
{{ else }}
  {{ range $year, $weeks := site.Data.spotify.weekly }}
    {{ range $weekId, $week := $weeks }}
      {{ $date := time.AsTime (printf "%sT00:00:00Z" $week.date_start) }}
      {{ $params := dict "hideAsideBar" true "weekData" $week "week" $week.week "weekDataKey" $weekId "yearDataKey" $year "year" $week.year "date_start" $week.date_start "date_end" $week.date_end "total_plays" $week.total_plays "unique_artists" $week.unique_artists "topArtistImages" ($week.topArtistImages | default slice) "topArtistName" $week.topArtistName }}
      {{ $page := dict "content" (dict "mediaType" "text/markdown" "value" (printf "%d plays · Top artist: %s" ($week.total_plays | int) $week.topArtistName)) "kind" "page" "title" $week.title "type" "listening-weekly" "params" $params "path" $weekId "dates" (dict "date" $date) }}
      {{ $.AddPage $page }}
    {{ end }}
  {{ end }}
{{ end }}
