{{/* Get remote data. */}}
{{ $data := dict }}
{{/*  {{ $url := "https://gohugo.io/shared/examples/data/books.json" }}
{{ with resources.GetRemote $url }}
  {{ with .Err }}
    {{ errorf "Unable to get remote resource %s: %s" $url . }}
  {{ else }}
    {{ $data = . | transform.Unmarshal }}
  {{ end }}
{{ else }}
  {{ errorf "Unable to get remote resource %s" $url }}
{{ end }}  */}}

{{ $data = hugo.Data.books.example }}


{{/* Add pages and page resources. */}}
{{ range $data }}

  {{/* Add page. */}}
  {{ $buttonLabel := .title }}
  {{ $extContent := add (printf "{{< amazon-associate-link button_label=\"%s\" >}} <!--more-->" $buttonLabel) .content }}
  {{ $content := dict "mediaType" "text/markdown" "value" $extContent }}
  {{ $dates := dict "date" (time.AsTime .date) }}
  {{ $params := dict "author" .author "isbn" .isbn "asin" .asin "rating" .rating "tags" .tags }}
  {{ $page := dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "type" "books"
    "params" $params
    "path" .title
    "title" .title
  }}
  {{ $.AddPage $page }}

  {{/* Add page resource. */}}
  {{ $item := . }}
  {{ with $url := $item.cover }}

    {{/* Covers are vendored under assets/images/books/ (copied from Hugo's
    docs examples), so this page needs no network at build time. It used to
    fetch them from gohugo.io with resources.GetRemote, which failed any build
    that couldn't reach that host. A missing file falls back to the placeholder
    with a warning. It never fails the build, because this is an old demo page
    kept only for its search traffic. */}}
    {{ $cover := resources.Get $url }}
    {{ $isPlaceholder := false }}
    {{ if not $cover }}
      {{ warnf "Book cover %q not found under assets/ — using local placeholder cover" $url }}
      {{ $cover = resources.Get "images/books/placeholder-cover.png" }}
      {{ $isPlaceholder = true }}
    {{ end }}

    {{ with $cover }}
      {{ $alt := $item.title }}
      {{ if $isPlaceholder }}
        {{ $alt = printf "%s (cover image unavailable)" $item.title }}
      {{ end }}
      {{ $content := dict "mediaType" .MediaType.Type "value" .Content }}
      {{ $params := dict "alt" $alt "placeholder" $isPlaceholder }}
      {{ $resource := dict
        "content" $content
        "params" $params
        "path" (printf "%s/feature_cover.%s" $item.title .MediaType.SubType)
      }}
      {{ $.AddResource $resource }}
    {{ end }}

  {{ end }}

{{ end }}