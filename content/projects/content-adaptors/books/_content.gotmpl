{{/* Get remote data. */}}
{{ $data := dict }}
{{/*  {{ $url := "https://gohugo.io/shared/examples/data/books.json" }}
{{ with resources.GetRemote $url }}
  {{ with .Err }}
    {{ errorf "Unable to get remote resource %s: %s" $url . }}
  {{ else }}
    {{ $data = . | transform.Unmarshal }}
  {{ end }}
{{ else }}
  {{ errorf "Unable to get remote resource %s" $url }}
{{ end }}  */}}

{{ $data = site.Data.books.example }}


{{/* Add pages and page resources. */}}
{{ range $data }}

  {{/* Add page. */}}
  {{ $buttonLabel := .title }}
  {{ $extContent := add (printf "{{< amazon-associate-link button_label=\"%s\" >}} <!--more-->" $buttonLabel) .content }}
  {{ $content := dict "mediaType" "text/markdown" "value" $extContent }}
  {{ $dates := dict "date" (time.AsTime .date) }}
  {{ $params := dict "author" .author "isbn" .isbn "asin" .asin "rating" .rating "tags" .tags }}
  {{ $page := dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "type" "books"
    "params" $params
    "path" .title
    "title" .title
  }}
  {{ $.AddPage $page }}

  {{/* Add page resource. */}}
  {{ $item := . }}
  {{ with $url := $item.cover }}

    {{/* Fetch the cover. A blocked or unreachable host raises a hard template
    error rather than setting .Err, so wrap the call in `try` to catch both
    that and an HTTP-status failure. */}}
    {{ $cover := "" }}
    {{ $err := "" }}
    {{ $attempt := try (resources.GetRemote $url) }}
    {{ with $attempt.Err }}
      {{ $err = . }}
    {{ else }}
      {{ with $attempt.Value }}
        {{ with .Err }}
          {{ $err = . }}
        {{ else }}
          {{ $cover = $attempt.Value }}
        {{ end }}
      {{ else }}
        {{ $err = "no resource returned" }}
      {{ end }}
    {{ end }}

    {{/* Production builds run on Amplify with open network, so a failure there
    is real and must stop the build. Elsewhere — notably Claude Code on the web,
    where gohugo.io is not reachable through the proxy — fall back to a local
    placeholder so the site still builds and every other page can be checked. */}}
    {{ $isPlaceholder := false }}
    {{ with $err }}
      {{ if eq hugo.Environment "production" }}
        {{ errorf "Unable to get remote resource %s: %s" $url . }}
      {{ else }}
        {{ warnf "Unable to get remote resource %s: %s — using local placeholder cover" $url . }}
        {{ $cover = resources.Get "images/books/placeholder-cover.png" }}
        {{ $isPlaceholder = true }}
      {{ end }}
    {{ end }}

    {{ with $cover }}
      {{ $alt := $item.title }}
      {{ if $isPlaceholder }}
        {{ $alt = printf "%s (cover image unavailable)" $item.title }}
      {{ end }}
      {{ $content := dict "mediaType" .MediaType.Type "value" .Content }}
      {{ $params := dict "alt" $alt "placeholder" $isPlaceholder }}
      {{ $resource := dict
        "content" $content
        "params" $params
        "path" (printf "%s/feature_cover.%s" $item.title .MediaType.SubType)
      }}
      {{ $.AddResource $resource }}
    {{ end }}

  {{ end }}

{{ end }}